[TextureSource]
[Category("Source")]
[Summary("")]
shader poussierefinal_TextureFX : TextureFX, Global
{
SamplerState samplerState{Filter = MIN_MAG_MIP_LINEAR;};
int2 resolution;
float v1;
float v2;
float v4;
float v5;
float v6;
float so;
float no(float2 p){ float2 f = floor(p); p = smoothstep(0.,1.,frac(p));
float2 e = float2(45.,98.);float tt = 78452.236;float2 a = dot(f,e)+float2(0.,e.y);
float2 b = lerp(frac(sin(a)*tt),frac(sin(a+e.x)*tt),p.x);
return sin(lerp(b.x,b.y,p.y)*6.28+Time)*0.5+0.5;}
float hs(float2 p){ return frac(sin(dot(p,float2(45.236,98.245)))*7845.265);}
float3 sat(float3 t1,  float v){
  float3 w = float3(0.2125, 0.7154, 0.0721);
            float l = dot(t1, w);
           return  lerp(float3(l,l,l), t1, v);}
    stage override float4 Shading()
    {
    float2 uv = (streams.TexCoord.xy);
    float Pi = 6.28318530718;

      float3 e = float3(1./resolution.x,0.,1./resolution.y)*4.;

      float3 col = float3(0.,0.,0.);
    float Directions = 8.0;
    float Quality = 2.0;
    float s =Texture1.SampleLevel(samplerState,uv+e.xy,0).x*so;
    float2 Radius = s/resolution*40.*v2;

    for( float d=0.0; d<Pi; d+=Pi/Directions)
    {
        for(float i=1.0/Quality; i<=1.0; i+=1.0/Quality)
        {
            col += Texture2.SampleLevel(samplerState, uv+float2(cos(d),sin(d))*Radius*float(i),0).xyz;
        }
    }
    col /= Directions*Quality;


    float t1 = Texture1.SampleLevel(samplerState,uv+e.xy,0).y;
    float t2 = Texture1.SampleLevel(samplerState,uv-e.xy,0).y;
    float t3 = Texture1.SampleLevel(samplerState,uv+e.yz,0).y;
    float t4 = Texture1.SampleLevel(samplerState,uv-e.yz,0).y;
    float3 n = normalize(float3(t1-t2,t3-t4,64.));
    float2 n2 = (n.xy+(no(uv*4.+Time*0.1)-0.5)*0.005+(float2(hs(uv),hs(uv+56.))-.5)*0.005)*v1*2.;
    float3 c2 = sat(col,1.+v4);
    float3 c =lerp(sat(Texture2.SampleLevel(samplerState, uv,0.).xyz,1.-v4)*v5,
    max(c2,Texture0.SampleLevel(samplerState, uv+n2,0).xyz*0.99),max(s,v6));
        return float4(c,1.);
    }
};
