[TextureSource]
[Category("Source")]
[Summary("")]
shader final_TextureFX : TextureFX
{
SamplerState samplerState{Filter = MIN_MAG_MIP_LINEAR;};
int2 resolution;
float blurQuality;float3 hue; float blur;
float3 low;float3 mid; float3 high;float4 level;
float s1;float s2; float s3;

float3 InvLerp(float3 A, float3 B, float3 t){return (t - A) / (B - A);}
float3 lev(float3 color, float4 l){
    color = (color - l.x) / (l.y - l.x) * (l.w - l.z) + l.z;
    return color;}

float3 co(float3 InColor ,float3 s, float3 m, float3 h){
    float3 OffShadows  = InColor + s;
    float3 OffMidtones = InColor + m;
    float3 OffHilights = InColor + h;
    return lerp(
        lerp(OffShadows,  OffMidtones, InvLerp(float3(0.0, 0.0, 0.0), float3(0.5, 0.5, 0.5), InColor)),
        lerp(OffMidtones, OffHilights, InvLerp(float3(0.5, 0.5, 0.5), float3(1.0, 1.0, 1.0), InColor)),
        step( float3(0.5, 0.5, 0.5), InColor));
}
float hs(float2 p){ return frac(sin(dot(p,float2(45.56,98.25)))*7845.239);}
float4x4 sat( float saturation )
{
    float3 luminance = float3( 0.3086, 0.6094, 0.0820 );

    float oneMinusSat = 1.0 - saturation;
    float lo = luminance.x * oneMinusSat;
    float3 red = float3( lo,lo,lo );
    red+= float3( saturation, 0, 0 );

    float3 green = float3( lo,lo,lo );
    green += float3( 0, saturation, 0 );

    float3 blue = float3( lo,lo,lo );
    blue += float3( 0, 0, saturation );

    return float4x4( red,     0,
                 green,   0,
                 blue,    0,
                 0, 0, 0, 1 );
}

    stage override float4 Shading()
    {
      float2 uv = (streams.TexCoord.xy);
      float2 res = float2(resolution);

      float tau = 3.14159265*4.;
      float bq = clamp(blurQuality,0.2,2.);
        float Directions = 16.0*bq;
        float Quality = 4.0*bq;
        float2 Radius =pow(length(uv.y-0.5)*2.,1.+(1.-s2))*60./res*blur*lerp(0.5,1.,s1)*lerp(0.8,1.,hs(uv));
        float3 c = float3(0.,0.,0.);
        for( float d=0.0; d<Pi; d+=Pi/Directions)
        {
            for(float i=1.0/Quality; i<=1.0; i+=1.0/Quality)
            {
                float2 md = float2(cos(d*2.),sin(d*2.));
                c +=Texture0.SampleLevel(samplerState, uv+md*Radius*i,0).xyz;
            }
        }
        c /= Quality * Directions;
        c = clamp(c,0.,1.);
        float ss2 = lerp(-0.1,0.1,s2)*2.;
        float3 c1 = lerp(c,(3.*abs(1.-2.*frac((1.-c.x)*hue.x+hue.y-ss2+float3(0.,-1./3.,1./3.)))-1.)*c,(1.-c)*hue.z);
        float3 c2 = co(c1, low, mid , high);
        float3 c3 = lev(c2,level);
        c3 = mul(c3,sat(lerp(0.5,1.5,s3)));
          return float4(c3,1.);
      }
};
