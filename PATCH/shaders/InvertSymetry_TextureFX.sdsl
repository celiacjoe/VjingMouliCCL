[TextureSource]
[Category("Source")]
[Summary("")]
shader InvertSymetry_TextureFX : TextureFX
{
    SamplerState samplerState
{
Filter = MIN_MAG_MIP_LINEAR;
AddressU = Mirror;
    AddressV = mirror;
};
float fac;
    stage override float4 Shading()
    {
     float2 uv = (streams.TexCoord.xy);
     uv.x = lerp(uv.x,1.-uv.x,step(0.8,fac));
     float3 c = Texture0.SampleLevel(samplerState, uv, 0).xyz;
        return float4(c,1.);
    }
};