[TextureSource]
[Category("Source")]
[Summary("")]
shader symetry_TextureFX : TextureFX
{
     SamplerState samplerState
{
Filter = MIN_MAG_MIP_LINEAR;
AddressU = Mirror;
    AddressV = mirror;

};
float symVectical; float symHorizontal;
    stage override float4 Shading()
    {
     float2 uv = (streams.TexCoord.xy);
       uv.y = lerp(uv.y,1.-uv.y,step(0.5,uv.y)*symVectical);
       uv.x = lerp(uv.x,1.-uv.x,step(0.5,uv.x)*symHorizontal);
        return  Texture0.SampleLevel(samplerState, uv, 0);
    }
};